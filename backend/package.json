{
  "name": "kilimo-bridge-backend",
  "version": "1.0.0",
  "main": "dist/backend/src/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/ensure-deps.js",
    "dev": "tsx watch src/index.ts",
    "dev:clean": "lsof -ti:3001 | xargs kill -9 2>/dev/null || true; tsx watch src/index.ts",
    "build": "tsc",
    "build:render": "node scripts/ensure-shared.js && npm install --include=dev && npm run build",
    "start": "node dist/backend/src/index.js",
    "seed": "tsx src/seed.ts",
    "seed:hierarchy": "tsx scripts/seed-hierarchy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1101.0",
    "@aws-sdk/s3-request-presigner": "^3.1101.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.19.0",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "papaparse": "^5.4.1",
    "pg": "^8.22.0",
    "uuid": "^9.0.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.12.0",
    "@types/papaparse": "^5.3.14",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0"
  }
}
