# Kilimo Bridge — Security & Environment Configuration
# Copy to .env and set production values

NODE_ENV=development
PORT=3001

# JWT signing secret — generate with: openssl rand -hex 64
JWT_SECRET=change-this-in-production

# AES-256 field encryption key — generate with: openssl rand -hex 32
ENCRYPTION_KEY=change-this-32-char-encryption-key!

# HMAC key for id_number_hash duplicate detection — generate with: openssl rand -hex 32
# Separate from ENCRYPTION_KEY so encryption rotation does not invalidate hash lookups.
ID_NUMBER_HMAC_KEY=change-this-id-number-hmac-key!

# Supabase Postgres connection string (transaction pooler recommended)
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Equity Bank H2H Integration (legacy REST path — still used for sim/webhook)
EQUITY_H2H_URL=https://api.equitybank.co.ke/h2h/v1
EQUITY_API_KEY=
EQUITY_WEBHOOK_SECRET=
EQUITY_TIMEOUT_MS=30000

# Equity Bank SFTP file-exchange (batch CSV + PGP). No live SFTP client yet.
# EQUITY_SFTP_USERNAME / EQUITY_SFTP_PASSWORD — set in Render only, never commit.
EQUITY_SFTP_HOST=
EQUITY_SFTP_PORT=1022
EQUITY_SFTP_TEMPLATE_ID=TMP224
EQUITY_SFTP_CUSTOMER_ID=
EQUITY_SFTP_ENTITY_CODE=DRAPIUS
EQUITY_SFTP_FILENAME_MD=MD
EQUITY_SFTP_DEBIT_ACCOUNT=
# PGP: our private key (decrypt) + Equity public key (encrypt outbound)
EQUITY_PGP_PRIVATE_KEY_PATH=
EQUITY_PGP_PASSPHRASE=
EQUITY_BANK_PUBLIC_KEY_PATH=
# Expected fingerprint of Equity's public key (spaces optional) — fail closed on mismatch
EQUITY_BANK_PGP_FINGERPRINT=

# Payment workflow
USE_EQUITY_H2H=false
REQUIRE_PAYMENT_VERIFICATION=false

# Comma-separated web origins (Netlify URL) for browser API access
CORS_ORIGINS=https://your-site.netlify.app

# Demo OTP until SMS is live
PILOT_OTP=true

# Skip PM review step in dev — new farmers go straight to pending_field_verification
PILOT_AUTO_FIELD_VERIFICATION=true

# Cloudflare R2 — private photo storage (pre-signed upload/read URLs)
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=kilimo-bridge-photos
CLOUDFLARE_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Project tracker dashboard — set a secret key, pass as header X-Tracker-Key
TRACKER_API_KEY=
